# ── 複製本檔為 .env.dev 後再改值（.env.* 不進版控）──
# 本機開發用，安全性放寬、media 走本地檔案系統。

DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web
APP_NAME=fullstackapp
APP_VERSION=0.1.0
ADMIN_SITE_TITLE=fullstackapp 後台
ADMIN_SITE_HEADER=fullstackapp 後台
ADMIN_INDEX_TITLE=管理首頁

# Database（compose 內服務名為 db）
DATABASE_URL=postgres://fullstackapp:fullstackapp@db:5432/fullstackapp
DB_USE_POOL=False

# Redis / Celery（compose 內服務名為 redis）
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/3

# CORS（dev 由 vite:3000 打 web:8000，已用 vite proxy，預設不需放寬）
CORS_ALLOW_ALL_ORIGINS=True

# Media：dev 用本地檔案系統
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
MEDIA_URL=/media/

# Email：dev 印到 console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# Logging
LOG_FORMAT=console
LOG_LEVEL=INFO
LOG_SERVICE_NAME=web

# Error tracking（dev 預設不啟用；要本機試 Sentry 再填 DSN）
SENTRY_DSN=

# API throttle（應用層限流；dev 放寬）
THROTTLE_ANON=120/min
THROTTLE_USER=2000/min
THROTTLE_LOGIN=20/min

# DDoS：dev 關閉
DDOS_PROTECTION_ENABLED=False
