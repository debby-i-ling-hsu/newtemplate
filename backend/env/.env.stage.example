# ── 複製本檔為 .env.stage 後填入真實祕密（.env.* 不進版控）──
# Stage 鏡像 prod：media 走 Azure Blob，但用「與 prod 不同」的儲存帳號。

DJANGO_ENV=stage
DJANGO_SETTINGS_MODULE=config.settings.stage
SECRET_KEY=__CHANGE_ME__
DEBUG=False
ALLOWED_HOSTS=stage.example.com,web
APP_NAME=fullstackapp
APP_VERSION=0.1.0
ADMIN_SITE_TITLE=fullstackapp 後台
ADMIN_SITE_HEADER=fullstackapp 後台
ADMIN_INDEX_TITLE=管理首頁

# Database（POSTGRES_PASSWORD 要與 DATABASE_URL 內密碼一致）
DATABASE_URL=postgres://fullstackapp:__CHANGE_ME__@db:5432/fullstackapp
POSTGRES_DB=fullstackapp
POSTGRES_USER=fullstackapp
POSTGRES_PASSWORD=__CHANGE_ME__
DB_USE_POOL=True
DB_POOL_MAX_SIZE=8

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/3
CELERY_REQUIRED_WORKERS=worker-default,worker-maintenance,worker-long-running

# CORS / CSRF（同網域由 Caddy 反代，通常只需 CSRF_TRUSTED_ORIGINS）
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=https://stage.example.com

# Media：Azure Blob（stage 專用帳號，勿與 prod 共用）
DEFAULT_FILE_STORAGE=storages.backends.azure_storage.AzureStorage
AZURE_ACCOUNT_NAME=__STAGE_ACCOUNT__
AZURE_ACCOUNT_KEY=__CHANGE_ME__
AZURE_CONTAINER=media

# Email（範例：SendGrid via anymail）
EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@stage.example.com
SENDGRID_API_KEY=__CHANGE_ME__

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Error tracking（留空＝不啟用）
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# API throttle（應用層限流）
THROTTLE_ANON=60/min
THROTTLE_USER=1000/min
THROTTLE_LOGIN=10/min

# DDoS：stage 開啟（Caddy 是唯一反代 → 1 跳）
DDOS_PROTECTION_ENABLED=True
DDOS_TRUSTED_PROXY_COUNT=1
